# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solana
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Contract Configuration
# Options: demo | preset | custom
NEXT_PUBLIC_CONTRACT_MODE=demo

# For preset mode (use existing IDO):
# NEXT_PUBLIC_PRESET_IDO=raydium | solanium | duckstarter

# For custom mode (use your own contract):
# NEXT_PUBLIC_CONTRACT_ADDRESS=your-solana-contract-address

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000